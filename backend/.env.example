APP_ENV=development
APP_NAME=student-dropout-warning-system

DATABASE_URL=postgresql+psycopg://user:password@database:5432/dropout_system

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:3000

ML_MODEL_PATH=app/ml/artifacts/dropout-risk-v1/model.joblib
ML_METADATA_PATH=app/ml/model_registry/dropout-risk-v1/metadata.json
ML_EVALUATION_PATH=app/ml/model_registry/dropout-risk-v1/evaluation.json
ML_MANIFEST_PATH=app/ml/model_registry/dropout-risk-v1/artifact_manifest.json
ML_MODEL_REQUIRED=false

# Optional one-time bootstrap account.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=
